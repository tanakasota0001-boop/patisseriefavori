---
import { siteConfig } from '../data/siteConfig';
import ThreeCanvas from '../components/ThreeCanvas.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${siteConfig.store.nameEn} ｜ ${siteConfig.store.nameJa}`,
  description = siteConfig.store.description
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- OGP -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteConfig.store.nameEn} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={siteConfig.images.heroSlides[0].url} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Montserrat:wght@200;300;400;500;600&family=Shippori+Mincho:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🍰</text></svg>" />

    <style is:global>
      :root {
        --color-cream-bg: #faf8f5;
        --color-noir: #181716;
        --color-orange: #b4824d;
        --color-brand: #b4824d;
        --color-gold: #b4824d;
        --color-gold-light: #c4935f;
      }
      
      html,
      body {
        max-width: 100%;
        overflow-x: clip;
        position: relative;
        background-color: var(--color-cream-bg);
        color: var(--color-noir);
        font-family: 'Montserrat', 'Shippori Mincho', serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      ::selection {
        background-color: #eed6bd;
        color: #181716;
      }

      /* Custom scrollbar styling */
      ::-webkit-scrollbar {
        width: 7px;
      }
      ::-webkit-scrollbar-track {
        background: #f6f3eb;
      }
      ::-webkit-scrollbar-thumb {
        background: #c8bba3;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #b4824d;
      }

      .font-serif-title {
        font-family: 'Cormorant Garamond', 'Shippori Mincho', serif;
      }

      .font-serif-jp {
        font-family: 'Shippori Mincho', serif;
      }

      .writing-vertical-rl {
        writing-mode: vertical-rl;
      }
    </style>
  </head>
  <body class="selection:bg-gold-300 selection:text-noir-900 relative">
    <!-- Slender Gold Scroll Progress Indicator -->
    <div
      id="scroll-progress-bar"
      class="fixed top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-gold-500 via-gold-400 to-gold-600 origin-left z-[9999] pointer-events-none scale-x-0"
    ></div>

    <!-- 3D Three.js Background Particle Canvas -->
    <ThreeCanvas />

    <!-- Page Content -->
    <div class="relative z-10">
      <slot />
    </div>

    <!-- Initialize Scroll Animations & Lenis -->
    <script>
      import { initScrollExperience } from '../scripts/scrollAnimations';
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initScrollExperience);
      } else {
        initScrollExperience();
      }
    </script>
  </body>
</html>
