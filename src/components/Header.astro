---
import { siteConfig } from '../data/siteConfig';
const { store, navigation } = siteConfig;
---

<!-- Header Wrapper: Fixed overlay with smooth translation for show/hide behavior -->
<div id="header-wrapper" class="fixed top-0 left-0 right-0 z-50 text-cream-50 bg-transparent">
  <!-- Announcement Bar (Desktop) - Directly scrolls away with page scroll -->
  <div id="announcement-bar" class="w-full border-b border-[#2e2824] hidden md:block bg-[#1e1b18] text-[#faf0e6] shadow-sm overflow-hidden py-2.5 will-change-transform">
    <div class="max-w-[1560px] mx-auto px-6 sm:px-8 lg:px-12 flex justify-between items-center tracking-widest font-serif-jp text-xs">
      <div class="flex items-center space-x-6">
        <span class="flex items-center gap-1.5 text-[#faf0e6]/90 font-medium">
          <svg class="w-3.5 h-3.5 text-gold-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          {store.address}
        </span>
        <span class="h-3 w-px bg-white/20"></span>
        <span class="flex items-center gap-1.5 text-[#f5ede4]/90 font-medium">
          <svg class="w-3.5 h-3.5 text-gold-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          営業時間 {store.businessHours}（{store.holidays}定休）
        </span>
      </div>
      <div class="flex items-center space-x-3">
        {store.instagramUrl && (
          <a href={store.instagramUrl} target="_blank" rel="noopener noreferrer" class="hover:text-gold-600 text-[#f5ede4]/90 font-medium transition-colors" aria-label="Instagram">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
        )}
        {store.threadsUrl && (
          <a href={store.threadsUrl} target="_blank" rel="noopener noreferrer" class="hover:text-gold-600 text-[#f5ede4]/90 font-medium transition-colors" aria-label="Threads">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M18.263 11.097c-.03-3.486-1.92-5.586-5.111-5.586-2.13 0-3.922.963-4.863 2.499l2.062 1.438c.535-.843 1.272-1.543 2.628-1.543 1.528 0 2.318.85 2.544 2.431a15 15 0 0 0-2.236-.173c-4.125 0-6.068 1.867-6.068 4.336s1.943 3.99 4.804 3.99c3.139 0 5.013-2.115 5.781-4.735.798.361 1.348 1.204 1.348 2.47 0 3.387-3.907 5.232-7.22 5.232-4.885 0-8.077-3.207-8.077-8.424 0-6.392 4.223-10.487 9.9-10.487 3.808 0 5.69 1.671 6.97 3.914l2.108-1.475C21.44 2.078 18.331 0 13.663 0 6.227 0 1.168 5.277 1.168 12.934c0 7 4.953 11.066 10.856 11.066 4.878 0 9.809-2.846 9.809-7.716 0-2.545-1.46-4.231-3.569-5.187m-6.33 4.855c-1.077 0-2.026-.512-2.026-1.453 0-1.483 1.822-1.934 3.606-1.934.678 0 1.34.045 1.927.173-.422 1.927-1.671 3.215-3.508 3.214Z"/></svg>
          </a>
        )}
        {store.xUrl && (
          <a href={store.xUrl} target="_blank" rel="noopener noreferrer" class="hover:text-gold-600 text-[#f5ede4]/90 font-medium transition-colors" aria-label="X">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z"/></svg>
          </a>
        )}
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <header id="main-header" class="w-full transition-all duration-300 border-b-0">
    <div class="max-w-[1560px] mx-auto px-6 sm:px-8 lg:px-12">
      <div class="flex justify-between items-center h-20 sm:h-22 lg:h-24">
        <!-- Mobile Left: Menu Toggle Button -->
        <div class="flex items-center lg:hidden w-10">
          <button
            type="button"
            id="mobile-menu-toggle"
            class="p-2 -ml-2 transition-colors focus:outline-none"
            aria-label="メニューを開く"
          >
            <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <!-- Logo: Centered on mobile, Left on desktop -->
        <a href="#" class="group flex items-center justify-center lg:justify-start focus:outline-none flex-1 lg:flex-initial py-1">
          <img
            src={store.logoWhite || "/images/logo-white.png"}
            alt={store.nameEn}
            class="h-12 sm:h-14 lg:h-16 xl:h-[68px] w-auto max-w-[260px] sm:max-w-[320px] lg:max-w-[400px] object-contain transition-transform duration-300 group-hover:scale-102 drop-shadow-sm mx-auto lg:mx-0"
            id="main-logo-img"
            data-logo-dark={store.logo || "/images/logo.png"}
            data-logo-white={store.logoWhite || "/images/logo-white.png"}
          />
        </a>

        <!-- Desktop Nav -->
        <nav id="desktop-nav" class="hidden lg:flex items-center space-x-9 text-[12.5px] font-sans tracking-[0.2em] font-medium transition-colors">
          {navigation.links.map(link => (
            <a href={link.href} class="hover:text-gold-600 transition-colors uppercase py-1 border-b border-transparent hover:border-gold-600">
              {link.labelEn}
            </a>
          ))}
        </nav>

        <!-- Desktop Right: Contact Action Button -->
        <div class="hidden lg:flex items-center space-x-3">
          <a
            href={`tel:${store.tel.replace(/-/g, '')}`}
            id="contact-btn"
            class="relative px-5 py-2.5 text-[12px] tracking-[0.18em] uppercase border transition-all duration-300 font-medium group backdrop-blur-sm rounded-sm inline-flex items-center"
          >
            <span class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              <span>{navigation.contactBtnText}</span>
            </span>
          </a>
        </div>

        <!-- Mobile Right: Instagram Icon Link -->
        <div class="flex items-center justify-end lg:hidden w-10">
          <a
            href={store.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            id="mobile-instagram-link"
            class="p-2 -mr-2 transition-colors focus:outline-none hover:text-gold-600"
            aria-label="Instagram"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </header>
</div>

<!-- Fullscreen Mobile Menu Overlay (Slides in from Left, Text Fades in) -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-[100] bg-[#faf8f5] text-noir-900 flex flex-col justify-between overflow-y-auto px-6 sm:px-8 lg:px-12 py-0 lg:hidden shadow-2xl"
  style="display: none;"
>
  <!-- Top Bar: Matches Header Height (h-20 sm:h-22 lg:h-24), Logo, and Instagram Alignment Exactly -->
  <div class="menu-fade-top flex justify-between items-center h-20 sm:h-22 lg:h-24 flex-shrink-0 max-w-[1560px] mx-auto w-full">
    <!-- Left: Close Button -->
    <div class="flex items-center w-10">
      <button
        type="button"
        onclick="closeMobileMenu()"
        class="group p-2 -ml-2 text-stone-800 hover:text-gold-600 transition-colors focus:outline-none"
        aria-label="メニューを閉じる"
      >
        <svg class="menu-close-icon w-6 h-6 transition-transform duration-500 ease-out" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Center: Logo (Identical size and positioning as closed header) -->
    <a href="#" onclick="closeMobileMenu()" class="group flex items-center justify-center focus:outline-none flex-1 py-1">
      <img
        src={store.logo || "/images/logo.png"}
        alt={store.nameEn}
        class="h-12 sm:h-14 w-auto max-w-[260px] sm:max-w-[320px] object-contain transition-transform duration-300 group-hover:scale-102 mx-auto"
      />
    </a>

    <!-- Right: Instagram Icon Link (Identical size and positioning as closed header) -->
    <div class="flex items-center justify-end w-10">
      {store.instagramUrl && (
        <a
          href={store.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 -mr-2 text-stone-800 hover:text-gold-600 transition-colors focus:outline-none"
          aria-label="Instagram"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.449-1.44z"/>
          </svg>
        </a>
      )}
    </div>
  </div>

  <!-- Navigation Links (Editorial Left-aligned with > indicator) -->
  <nav class="flex-1 flex flex-col items-start justify-center py-4 space-y-3.5 my-auto max-w-[1560px] mx-auto w-full">
    {navigation.links.map((link) => (
      <a
        href={link.href}
        class="mobile-nav-link menu-fade-item group text-left flex items-center gap-3 py-1.5 transition-all duration-300 w-full"
      >
        <span class="text-sm font-sans text-gold-600 font-medium transition-transform duration-300 group-hover:translate-x-1 select-none flex-shrink-0">
          &gt;
        </span>
        <div class="flex flex-col items-start">
          <span class="font-serif-title tracking-[0.2em] text-2xl sm:text-3xl font-light text-stone-900 group-hover:text-gold-600 transition-colors uppercase">
            {link.labelEn}
          </span>
          <span class="text-xs text-stone-500 tracking-[0.15em] font-serif-jp -mt-0.5 group-hover:text-gold-600 transition-colors">
            {link.labelJa}
          </span>
        </div>
      </a>
    ))}
  </nav>

  <!-- Bottom Action & Contact Info Area (Left-aligned & Organized) -->
  <div class="menu-fade-bottom flex-shrink-0 max-w-[1560px] mx-auto w-full pt-4 pb-8 space-y-4 text-left">
    <!-- CTA Call Button -->
    <a
      href={`tel:${store.tel.replace(/-/g, '')}`}
      class="w-full py-3.5 bg-gold-600 hover:bg-gold-700 text-white text-xs font-sans tracking-widest uppercase font-medium transition-colors rounded-sm shadow-md inline-flex items-center justify-center gap-2"
    >
      <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
      <span>TEL: {store.tel}</span>
    </a>

    <!-- Info -->
    <div class="text-xs font-serif-jp text-stone-600 pl-0.5">
      <span>営業時間 {store.businessHours}（{store.holidays}定休）</span>
    </div>

    <!-- SNS Links (Threads / X if configured) -->
    {(store.threadsUrl || store.xUrl) && (
      <div class="flex items-center justify-center gap-6 w-full pt-1">
        {store.threadsUrl && (
          <a
            href={store.threadsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center py-2 text-[#321609] hover:text-gold-600 transition-colors group"
            aria-label="Threads"
          >
            <svg class="w-6 h-6 fill-current transition-transform duration-300 group-hover:scale-110" viewBox="0 0 24 24"><path d="M18.263 11.097c-.03-3.486-1.92-5.586-5.111-5.586-2.13 0-3.922.963-4.863 2.499l2.062 1.438c.535-.843 1.272-1.543 2.628-1.543 1.528 0 2.318.85 2.544 2.431a15 15 0 0 0-2.236-.173c-4.125 0-6.068 1.867-6.068 4.336s1.943 3.99 4.804 3.99c3.139 0 5.013-2.115 5.781-4.735.798.361 1.348 1.204 1.348 2.47 0 3.387-3.907 5.232-7.22 5.232-4.885 0-8.077-3.207-8.077-8.424 0-6.392 4.223-10.487 9.9-10.487 3.808 0 5.69 1.671 6.97 3.914l2.108-1.475C21.44 2.078 18.331 0 13.663 0 6.227 0 1.168 5.277 1.168 12.934c0 7 4.953 11.066 10.856 11.066 4.878 0 9.809-2.846 9.809-7.716 0-2.545-1.46-4.231-3.569-5.187m-6.33 4.855c-1.077 0-2.026-.512-2.026-1.453 0-1.483 1.822-1.934 3.606-1.934.678 0 1.34.045 1.927.173-.422 1.927-1.671 3.215-3.508 3.214Z"/></svg>
          </a>
        )}
        {store.xUrl && (
          <a
            href={store.xUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center py-2 text-[#321609] hover:text-gold-600 transition-colors group"
            aria-label="X"
          >
            <svg class="w-6 h-6 fill-current transition-transform duration-300 group-hover:scale-110" viewBox="0 0 24 24"><path d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z"/></svg>
          </a>
        )}
      </div>
    )}
  </div>
</div>

<script is:inline>
  const headerWrapper = document.getElementById('header-wrapper');
  const announcementBar = document.getElementById('announcement-bar');
  const mainLogoImg = document.getElementById('main-logo-img');
  const logoDark = mainLogoImg ? mainLogoImg.getAttribute('data-logo-dark') : '/images/logo.png';
  const logoWhite = mainLogoImg ? mainLogoImg.getAttribute('data-logo-white') : '/images/logo-white.png';
  const logoTitle = document.getElementById('logo-title');
  const logoSubtitle = document.getElementById('logo-subtitle');
  const desktopNav = document.getElementById('desktop-nav');
  const contactBtn = document.getElementById('contact-btn');
  const mobileToggle = document.getElementById('mobile-menu-toggle');
  const mobileInstagram = document.getElementById('mobile-instagram-link');

  let lastScrollY = window.scrollY;
  let isAnnouncementVisible = true;
  let isScrolledTheme = false;

  function setTransparentTheme() {
    if (!isScrolledTheme) return;
    isScrolledTheme = false;

    headerWrapper.classList.add('text-cream-50', 'bg-transparent');
    headerWrapper.classList.remove('text-noir-900', 'bg-cream-50/95', 'backdrop-blur-md', 'shadow-sm');

    if (mainLogoImg && logoWhite) {
      mainLogoImg.src = logoWhite;
    }

    logoTitle?.classList.add('text-cream-50');
    logoTitle?.classList.remove('text-noir-900');

    logoSubtitle?.classList.add('text-cream-200');
    logoSubtitle?.classList.remove('text-stone-500');

    desktopNav.classList.add('text-cream-100');
    desktopNav.classList.remove('text-stone-700');

    contactBtn.classList.add('border-white/60', 'text-cream-50', 'hover:bg-cream-50', 'hover:text-noir-900');
    contactBtn.classList.remove('border-stone-800', 'text-noir-900', 'hover:bg-noir-900', 'hover:text-cream-50');

    mobileToggle.classList.add('text-cream-50');
    mobileToggle.classList.remove('text-stone-800');

    if (mobileInstagram) {
      mobileInstagram.classList.add('text-cream-50');
      mobileInstagram.classList.remove('text-stone-800');
    }
  }

  function setSolidScrolledTheme() {
    if (isScrolledTheme) return;
    isScrolledTheme = true;

    headerWrapper.classList.remove('text-cream-50', 'bg-transparent');
    headerWrapper.classList.add('text-noir-900', 'bg-cream-50/95', 'backdrop-blur-md', 'shadow-sm');

    if (mainLogoImg && logoDark) {
      mainLogoImg.src = logoDark;
    }

    logoTitle?.classList.remove('text-cream-50');
    logoTitle?.classList.add('text-noir-900');

    logoSubtitle?.classList.remove('text-cream-200');
    logoSubtitle?.classList.add('text-stone-500');

    desktopNav.classList.remove('text-cream-100');
    desktopNav.classList.add('text-stone-700');

    contactBtn.classList.remove('border-white/60', 'text-cream-50', 'hover:bg-cream-50', 'hover:text-noir-900');
    contactBtn.classList.add('border-stone-800', 'text-noir-900', 'hover:bg-gold-600', 'hover:text-white', 'hover:border-gold-600');

    mobileToggle.classList.remove('text-cream-50');
    mobileToggle.classList.add('text-stone-800');

    if (mobileInstagram) {
      mobileInstagram.classList.remove('text-cream-50');
      mobileInstagram.classList.add('text-stone-800');
    }
  }

  function handleHeaderScroll() {
    const currentScrollY = window.scrollY;
    const barHeight = announcementBar ? announcementBar.offsetHeight : 0;

    // 1. Top Zone (0px to 140px):
    // The announcement bar slides up strictly with scroll position (natural 1:1 scroll feel)
    if (currentScrollY <= 140) {
      if (announcementBar) {
        // Translate announcement bar smoothly as user scrolls
        const translateY = -Math.min(currentScrollY, barHeight);
        announcementBar.style.transform = `translateY(${translateY}px)`;
      }

      // Main header stays fixed directly below the moving announcement bar
      const headerTranslate = -Math.min(currentScrollY, barHeight);
      headerWrapper.style.transition = 'none';
      headerWrapper.style.transform = `translateY(${headerTranslate}px)`;

      // Transparent theme at the very top
      if (currentScrollY <= 20) {
        setTransparentTheme();
      }
    } else {
      // 2. Below Top Zone (> 140px):
      // Announcement bar is fully out of view
      if (announcementBar) {
        announcementBar.style.transform = `translateY(-${barHeight}px)`;
      }

      headerWrapper.style.transition = 'transform 0.4s ease-out, background-color 0.4s ease-out';

      const isScrollingDown = currentScrollY > lastScrollY + 4;
      const isScrollingUp = currentScrollY < lastScrollY - 4;

      if (isScrollingDown) {
        // Hide entire header when scrolling down
        headerWrapper.style.transform = 'translateY(-100%)';
      } else if (isScrollingUp) {
        // Show navigation menu on scroll up (offset announcement bar so only menu shows)
        headerWrapper.style.transform = `translateY(-${barHeight}px)`;
        setSolidScrolledTheme();
      }
    }

    lastScrollY = Math.max(0, currentScrollY);
  }

  // Initial setup
  isScrolledTheme = true;
  setTransparentTheme();

  window.addEventListener('scroll', handleHeaderScroll, { passive: true });
  handleHeaderScroll();

  // Fullscreen Mobile Menu Controller (Slide-in from left, text fade-in)
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  window.openMobileMenu = function() {
    if (!mobileMenu) return;
    mobileMenu.style.display = 'flex';
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        mobileMenu.classList.add('menu-open');
      });
    });
    document.body.style.overflow = 'hidden';
  };

  window.closeMobileMenu = function() {
    if (!mobileMenu) return;
    mobileMenu.classList.remove('menu-open');
    setTimeout(() => {
      if (!mobileMenu.classList.contains('menu-open')) {
        mobileMenu.style.display = 'none';
      }
    }, 450);
    document.body.style.overflow = '';
  };

  window.toggleMobileMenu = function() {
    if (mobileMenu && mobileMenu.classList.contains('menu-open')) {
      closeMobileMenu();
    } else {
      openMobileMenu();
    }
  };

  toggleBtn?.addEventListener('click', toggleMobileMenu);

  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', closeMobileMenu);
  });
</script>

<style>
  /* Fullscreen menu container slide-in from left */
  #mobile-menu {
    transform: translateX(-100%);
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  #mobile-menu.menu-open {
    transform: translateX(0);
  }

  /* Top bar fade-in and close button rotation */
  #mobile-menu .menu-fade-top {
    opacity: 0;
    transition: opacity 0.35s ease 0.1s;
  }
  #mobile-menu.menu-open .menu-fade-top {
    opacity: 1;
  }

  #mobile-menu .menu-close-icon {
    transform: rotate(-90deg) scale(0.85);
    opacity: 0;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.15s, opacity 0.4s ease 0.15s;
    transform-origin: center;
  }

  #mobile-menu.menu-open .menu-close-icon {
    transform: rotate(0deg) scale(1);
    opacity: 1;
  }

  #mobile-menu .group:hover .menu-close-icon {
    transform: rotate(90deg) scale(1.1);
  }

  #mobile-menu .group:active .menu-close-icon {
    transform: rotate(90deg) scale(0.9);
  }

  /* Navigation items staggered fade-in with subtle upward glide */
  #mobile-menu .menu-fade-item {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  #mobile-menu.menu-open .menu-fade-item {
    opacity: 1;
    transform: translateY(0);
  }

  /* Stagger delays for elegant editorial reveal */
  #mobile-menu.menu-open .menu-fade-item:nth-child(1) { transition-delay: 0.15s; }
  #mobile-menu.menu-open .menu-fade-item:nth-child(2) { transition-delay: 0.20s; }
  #mobile-menu.menu-open .menu-fade-item:nth-child(3) { transition-delay: 0.25s; }
  #mobile-menu.menu-open .menu-fade-item:nth-child(4) { transition-delay: 0.30s; }
  #mobile-menu.menu-open .menu-fade-item:nth-child(5) { transition-delay: 0.35s; }
  #mobile-menu.menu-open .menu-fade-item:nth-child(6) { transition-delay: 0.40s; }

  /* Bottom actions fade-in */
  #mobile-menu .menu-fade-bottom {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.45s, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.45s;
    will-change: opacity, transform;
  }

  #mobile-menu.menu-open .menu-fade-bottom {
    opacity: 1;
    transform: translateY(0);
  }
</style>
