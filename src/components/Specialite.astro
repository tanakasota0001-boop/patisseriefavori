---
import { siteConfig } from '../data/siteConfig';
const { specialite: specConfig } = siteConfig.images;
const { specialite: specText } = siteConfig.content;
---

<section id="specialty" class="py-24 sm:py-32 bg-cream-50 text-noir-900 border-t border-stone-200/60 relative">
  <style>
    /* Sticky behavior for the content side on desktop */
    @media screen and (min-width: 1024px) {
      .yc-content-wrapper {
        position: -webkit-sticky;
        position: sticky;
        top: 6rem;
        align-self: flex-start;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: calc(100vh - 8rem);
      }
    }

    /* Images gallery grid styling */
    .yc-images-gallery {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }

    @media screen and (min-width: 640px) {
      .yc-images-gallery {
        gap: 10px;
      }
    }

    /* Base 4:5 aspect ratio for gallery cards */
    .yc-gallery-item {
      position: relative;
      overflow: hidden;
      aspect-ratio: 4 / 5;
      background-color: #ede7de;
      border-radius: 2px;
    }

    /* 3rd and 6th items span 2 columns with 3:2 panoramic aspect ratio */
    .yc-gallery-item:nth-child(3),
    .yc-gallery-item:nth-child(6) {
      grid-column: span 2;
      aspect-ratio: 3 / 2 !important;
    }

    .yc-gallery-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.7s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .yc-gallery-item:hover img {
      transform: scale(1.05);
    }

    /* Elegant gradient caption at bottom */
    .yc-gallery-caption {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 2.5rem 1.25rem 1.25rem;
      background: linear-gradient(to top, rgba(15, 12, 10, 0.82) 0%, rgba(15, 12, 10, 0.35) 60%, transparent 100%);
      color: #faf7f2;
      text-align: center;
      transition: all 0.3s ease;
      pointer-events: none;
    }
  </style>

  <div class="max-w-[1800px] mx-auto px-4 sm:px-6 lg:px-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
      
      <!-- Left Content (Sticky on Desktop) -->
      <div class="lg:col-span-5 yc-content-wrapper py-12 sm:py-16 lg:py-0">
        <div class="w-full max-w-lg mx-auto text-center space-y-6 lg:space-y-8 px-2 scroll-fade-in">
          
          <!-- Heading -->
          <div>
            <span class="text-[11px] sm:text-xs font-sans tracking-[0.3em] uppercase text-gold-600 font-semibold block mb-3">{specText.badge}</span>
            <h2 class="text-2xl sm:text-4xl lg:text-[42px] font-serif-jp text-stone-900 font-light leading-[1.45] tracking-[0.06em] whitespace-pre-line">
              {specText.heading}
            </h2>
            <div class="w-10 h-[1px] bg-gold-600/80 mx-auto mt-4"></div>
          </div>

          <!-- Description Text -->
          <p class="text-stone-700 font-serif-jp text-sm sm:text-[15px] leading-[2.1] tracking-[0.05em] whitespace-pre-line">
            {specText.desc}
          </p>

          <!-- Occasions Tags -->
          {specText.tags && (
            <div class="flex flex-wrap justify-center gap-2 pt-1 pb-2">
              {specText.tags.map((tag: string) => (
                <span class="text-[11px] font-sans tracking-wider px-3 py-1 bg-gold-50/90 text-gold-900 rounded-sm border border-gold-200/80 font-medium">{tag}</span>
              ))}
            </div>
          )}

          <!-- Reservation Button -->
          <div class="pt-2 space-y-3">
            <a
              href={`tel:${siteConfig.store.tel.replace(/-/g, '')}`}
              class="w-full sm:w-auto px-8 py-3.5 bg-gold-600 hover:bg-gold-700 text-white text-xs font-sans tracking-[0.2em] uppercase transition-all duration-300 font-medium rounded-sm shadow-md hover:shadow-lg inline-flex items-center justify-center gap-2 group"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              <span>{specText.catalogBtn}</span>
            </a>
            {specText.reservationNotice && (
              <p class="text-[11.5px] sm:text-[13px] md:text-sm font-serif-jp text-stone-700 font-medium tracking-normal sm:tracking-wider sm:whitespace-nowrap">
                {specText.reservationNotice}
              </p>
            )}
          </div>
        </div>
      </div>

      <!-- Right Gallery (Scrollable 2-column Grid with Panoramic Accents) -->
      <div class="lg:col-span-7 py-8 sm:py-12 lg:py-16">
        <div class="anim-card-grid yc-images-gallery">
          {specConfig.items.map((item) => (
            <div class="anim-card-item yc-gallery-item group shadow-sm select-none">
              <img
                src={item.image}
                alt={item.title}
                loading="lazy"
                class="card-img-parallax w-full h-full object-cover will-change-transform"
              />
              <div class="yc-gallery-caption z-20">
                <p class="text-xs sm:text-[13px] font-serif-title tracking-[0.22em] uppercase font-normal drop-shadow-sm">
                  {item.title}
                </p>
                <p class="text-[11px] sm:text-[12px] font-serif-jp text-cream-100/90 tracking-[0.14em] mt-0.5">
                  {item.subTitle}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
