---
import { siteConfig } from '../data/siteConfig';
const { store } = siteConfig;
const { store: storeText } = siteConfig.content;
---

<section id="store" class="py-24 sm:py-32 bg-cream-50 text-noir-900 border-t border-stone-200/60 relative">
  <div class="max-w-[1240px] mx-auto px-6 sm:px-8 lg:px-12 scroll-fade-in">
    <!-- Header -->
    <div class="anim-section-header text-center max-w-3xl mx-auto space-y-3.5 mb-12 sm:mb-16">
      <span class="anim-subtitle text-[11px] sm:text-xs font-sans tracking-[0.3em] uppercase text-gold-600 font-semibold block">{storeText.badge}</span>
      <h2 class="anim-title-en text-3xl sm:text-5xl lg:text-6xl font-serif-title tracking-[0.2em] font-light uppercase text-noir-900">
        {storeText.titleEn}
      </h2>
      <div class="anim-gold-line w-10 h-[1px] bg-gold-600/80 mx-auto"></div>
    </div>

    <!-- Store Layout: Unified Store Info & Calendar on Left, Map on Right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-stretch">
      
      <!-- Left Column: Store Info & Calendar (Natural / Flat Design) -->
      <div class="store-calendar-anim lg:col-span-6 flex flex-col justify-between space-y-6">
        
        <!-- Top: Store Identity -->
        <div class="border-b border-stone-300/80 pb-4">
          <h3 class="text-2xl sm:text-3xl lg:text-[28px] font-serif-title tracking-wider text-noir-900 font-light leading-snug">
            <span class="lowercase">pâtisserie</span> <span class="uppercase font-normal">favori</span>
          </h3>
        </div>

        <!-- Middle: Key Details Grid -->
        <dl class="py-5 divide-y divide-stone-200/60 text-sm sm:text-base font-serif-jp space-y-0">
          <div class="py-3 grid grid-cols-3 gap-2">
            <dt class="text-stone-800 font-sans tracking-wider uppercase text-xs sm:text-sm font-semibold flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-gold-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <span>{storeText.tableLabels.address}</span>
            </dt>
            <dd class="col-span-2 text-stone-900 font-normal text-sm sm:text-base">
              〒{store.postalCode} {store.address}
            </dd>
          </div>
          <div class="py-3 grid grid-cols-3 gap-2">
            <dt class="text-stone-800 font-sans tracking-wider uppercase text-xs sm:text-sm font-semibold flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-gold-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              <span>{storeText.tableLabels.tel}</span>
            </dt>
            <dd class="col-span-2 text-stone-900 font-normal text-sm sm:text-base">
              <a href={`tel:${store.tel.replace(/-/g, '')}`} class="hover:text-gold-600 transition-colors font-medium">
                {store.tel}
              </a>
            </dd>
          </div>
          <div class="py-3 grid grid-cols-3 gap-2">
            <dt class="text-stone-800 font-sans tracking-wider uppercase text-xs sm:text-sm font-semibold flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-gold-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span>{storeText.tableLabels.hours}</span>
            </dt>
            <dd class="col-span-2 text-stone-900 font-normal text-sm sm:text-base">
              <span>{store.businessHours}</span>
              <span class="text-xs sm:text-sm text-stone-500 ml-1.5">（{store.holidays}定休）</span>
            </dd>
          </div>
          <div class="py-3 grid grid-cols-3 gap-2">
            <dt class="text-stone-800 font-sans tracking-wider uppercase text-xs sm:text-sm font-semibold flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-gold-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <span>{storeText.tableLabels.access}</span>
            </dt>
            <dd class="col-span-2 text-stone-900 font-normal text-xs sm:text-sm space-y-1">
              {store.accessList.map(item => (
                <p>{item}</p>
              ))}
            </dd>
          </div>
          {store.parking && (
            <div class="py-3 grid grid-cols-3 gap-2">
              <dt class="text-stone-800 font-sans tracking-wider uppercase text-xs sm:text-sm font-semibold flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-gold-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
                <span>{storeText.tableLabels.parking}</span>
              </dt>
              <dd class="col-span-2 text-stone-900 font-normal text-sm sm:text-base">
                {store.parking}
              </dd>
            </div>
          )}
        </dl>

        <!-- Integrated Calendar Sub-section -->
        <div class="pt-6 border-t border-stone-300/80">
          <div class="flex justify-between items-center mb-3.5">
            <div>
              <h4 class="text-xs sm:text-sm font-sans tracking-widest uppercase text-stone-800 font-semibold">{storeText.calendarTitle}</h4>
            </div>
            <div class="flex items-center space-x-1.5">
              <button
                type="button"
                id="cal-prev-btn"
                class="p-1.5 rounded border border-stone-300 hover:bg-stone-200/50 text-stone-600 transition-colors"
                aria-label={storeText.calendar.prevMonthAria}
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
              </button>
              <span id="cal-month-title" class="text-xs sm:text-sm font-sans font-semibold text-stone-800 px-2 min-w-[85px] text-center"></span>
              <button
                type="button"
                id="cal-next-btn"
                class="p-1.5 rounded border border-stone-300 hover:bg-stone-200/50 text-stone-600 transition-colors"
                aria-label={storeText.calendar.nextMonthAria}
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </button>
            </div>
          </div>

          <!-- Calendar Days Grid -->
          <div class="calendar-wrapper bg-white/70 p-3.5 rounded border border-stone-200/80">
            <div class="grid grid-cols-7 gap-1 text-center font-sans text-xs text-stone-500 mb-1.5 font-semibold">
              {storeText.calendar.weekdays.map((day, idx) => (
                <span class={idx === 0 ? "text-berry-700" : idx === 6 ? "text-blue-600" : ""}>{day}</span>
              ))}
            </div>
            <div id="calendar-days-container" class="grid grid-cols-7 gap-1 text-center font-sans text-xs sm:text-sm"></div>
          </div>

          <!-- Calendar Legend -->
          <div class="mt-3 flex flex-wrap items-center justify-between text-xs text-stone-600 gap-2 font-serif-jp pt-1">
            <div class="flex items-center gap-4">
              <div class="flex items-center gap-1.5">
                <span class="w-3 h-3 rounded-full bg-berry-700/20 border border-berry-700/50"></span>
                <span>{storeText.legendHoliday}</span>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="w-3 h-3 rounded-full bg-gold-600/20 border border-gold-600"></span>
                <span>{storeText.legendToday}</span>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Map Frame (Full Height on Desktop) -->
      <div class="lg:col-span-6 h-full min-h-[420px] sm:min-h-[500px] lg:min-h-full flex flex-col justify-between">
        <div class="w-full flex-1 min-h-[380px] sm:min-h-[460px] lg:min-h-[480px] bg-stone-200 border border-stone-300 overflow-hidden shadow-sm rounded-sm">
          <iframe
            src={store.googleMapsEmbedUrl}
            width="100%"
            height="100%"
            style="border:0; min-height: 100%; height: 100%;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title={`${store.nameEn} 店舗所在地マップ`}
          ></iframe>
        </div>
        {store.googleMapsUrl && (
          <div class="mt-2.5 text-right">
            <a
              href={store.googleMapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-serif-jp text-stone-600 hover:text-gold-600 transition-colors"
            >
              <span>Google マップでルート・詳細を見る</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
          </div>
        )}
      </div>

    </div>
  </div>
</section>

<!-- Inject weekly holiday days and special dates for script -->
<script define:vars={{
  weeklyHolidayDays: store.weeklyHolidayDays,
  specialOpenDates: store.specialOpenDates || [],
  specialHolidayDates: store.specialHolidayDates || []
}}>
  window.__WEEKLY_HOLIDAYS__ = weeklyHolidayDays || [3];
  window.__SPECIAL_OPEN_DATES__ = specialOpenDates || [];
  window.__SPECIAL_HOLIDAY_DATES__ = specialHolidayDates || [];
</script>

<script is:inline>
  let currentCalDate = new Date();
  let viewYear = currentCalDate.getFullYear();
  let viewMonth = currentCalDate.getMonth();

  function isStoreHoliday(year, month, day) {
    const monthStr = String(month + 1).padStart(2, '0');
    const dayStr = String(day).padStart(2, '0');
    const fullDateStr = `${year}-${monthStr}-${dayStr}`;
    const shortDateStr = `${monthStr}-${dayStr}`;

    const specialOpen = window.__SPECIAL_OPEN_DATES__ || [];
    if (specialOpen.includes(fullDateStr) || specialOpen.includes(shortDateStr)) {
      return false;
    }

    const specialHoliday = window.__SPECIAL_HOLIDAY_DATES__ || [];
    if (specialHoliday.includes(fullDateStr) || specialHoliday.includes(shortDateStr)) {
      return true;
    }

    const d = new Date(year, month, day);
    const dayOfWeek = d.getDay(); // 0: Sun, 1: Mon, 2: Tue, 3: Wed...
    const holidays = window.__WEEKLY_HOLIDAYS__ || [3];
    if (holidays.includes(dayOfWeek)) return true;
    // 第1・第3火曜日 (2: Tue)
    if (dayOfWeek === 2) {
      const nthTuesday = Math.ceil(day / 7);
      if (nthTuesday === 1 || nthTuesday === 3) return true;
    }
    return false;
  }

  function renderCalendar(year, month) {
    const container = document.getElementById('calendar-days-container');
    const title = document.getElementById('cal-month-title');
    if (!container || !title) return;

    title.textContent = `${year}年 ${month + 1}月`;
    container.innerHTML = '';

    const firstDayIndex = new Date(year, month, 1).getDay();
    const lastDayDate = new Date(year, month + 1, 0).getDate();

    for (let i = 0; i < firstDayIndex; i++) {
      const emptyCell = document.createElement('div');
      emptyCell.className = 'h-9 text-stone-300 flex items-center justify-center';
      container.appendChild(emptyCell);
    }

    const today = new Date();
    const isThisMonth = today.getFullYear() === year && today.getMonth() === month;

    for (let day = 1; day <= lastDayDate; day++) {
      const dayCell = document.createElement('div');
      const isHoliday = isStoreHoliday(year, month, day);
      const isCurrentDay = isThisMonth && today.getDate() === day;
      const dayOfWeek = new Date(year, month, day).getDay();

      let cellClass = 'h-9 flex flex-col items-center justify-center rounded-sm transition-colors text-xs ';

      if (isCurrentDay) {
        cellClass += 'ring-1 ring-gold-600 font-bold bg-gold-600/10 ';
      }

      if (isHoliday) {
        cellClass += 'bg-berry-700/10 text-berry-800 font-medium ';
      } else {
        if (dayOfWeek === 0) cellClass += 'text-berry-700 ';
        else if (dayOfWeek === 6) cellClass += 'text-blue-600 ';
        else cellClass += 'text-stone-800 hover:bg-stone-100 ';
      }

      dayCell.className = cellClass;
      dayCell.innerHTML = `
        <span>${day}</span>
        ${isHoliday ? '<span class="text-[8px] scale-90 leading-none text-berry-700/80">休</span>' : ''}
      `;

      container.appendChild(dayCell);
    }
  }

  document.getElementById('cal-prev-btn')?.addEventListener('click', () => {
    viewMonth--;
    if (viewMonth < 0) {
      viewMonth = 11;
      viewYear--;
    }
    renderCalendar(viewYear, viewMonth);
  });

  document.getElementById('cal-next-btn')?.addEventListener('click', () => {
    viewMonth++;
    if (viewMonth > 11) {
      viewMonth = 0;
      viewYear++;
    }
    renderCalendar(viewYear, viewMonth);
  });

  renderCalendar(viewYear, viewMonth);
</script>
