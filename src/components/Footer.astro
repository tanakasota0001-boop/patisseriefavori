---
import { siteConfig } from '../data/siteConfig';
const { store, navigation } = siteConfig;
const { footer } = siteConfig.content;
---

<footer class="bg-[#1e1b18] text-[#faf0e6] pt-20 pb-14 border-t border-[#2e2824] relative">
  <div class="max-w-[1560px] mx-auto px-6 sm:px-8 lg:px-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 pb-16 border-b border-white/10">
      <!-- Brand Left -->
      <div class="md:col-span-5 space-y-4">
        <a href="#" class="inline-block group">
          <img
            src={store.logoWhite || "/images/logo-white.png"}
            alt={store.nameEn}
            class="h-12 sm:h-14 lg:h-16 w-auto max-w-[320px] object-contain mb-3 group-hover:opacity-90 transition-opacity"
          />
        </a>
        <p class="text-sm sm:text-[14.5px] font-serif-jp text-[#faf0e6]/85 leading-[2.1] tracking-[0.05em] max-w-sm">
          {store.shortConcept}
        </p>
      </div>

      <!-- Quick Nav -->
      <div class="md:col-span-3 space-y-4">
        <h4 class="text-xs sm:text-[13px] font-sans tracking-[0.25em] uppercase text-gold-500 font-semibold">{footer.navTitle}</h4>
        <ul class="space-y-3 text-sm sm:text-[14.5px] font-sans tracking-[0.15em] text-[#faf0e6]/80">
          {navigation.links.map(link => (
            <li><a href={link.href} class="hover:text-gold-400 transition-colors uppercase">{link.labelEn}</a></li>
          ))}
        </ul>
      </div>

      <!-- Info & Contact -->
      <div class="md:col-span-4 space-y-4">
        <h4 class="text-xs sm:text-[13px] font-sans tracking-[0.25em] uppercase text-gold-500 font-semibold">{footer.storeTitle}</h4>
        <address class="not-italic text-sm sm:text-[14.5px] font-serif-jp text-[#f5ede4]/85 space-y-2.5 leading-relaxed tracking-wide">
          <p>〒{store.postalCode} {store.address}</p>
          <p>
            <a href={`tel:${store.tel.replace(/-/g, '')}`} class="hover:text-gold-400 transition-colors font-medium">Tel. {store.tel}</a>
          </p>
          <p>営業時間：{store.businessHours}</p>
          <p>定休日：{store.holidays}</p>
          {store.parking && <p>駐車場：{store.parking}</p>}
        </address>

        <!-- Social Media Links (Icons Only, Enlarged, Transparent Background, Uniform Size) -->
        <div class="pt-4">
          <div class="flex items-center gap-4 text-[#f5ede4]/80">
            {store.instagramUrl && (
              <a
                href={store.instagramUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-gold-600 transition-all duration-300 hover:scale-115 inline-flex items-center justify-center p-1"
                aria-label="Instagram"
                title="Instagram"
              >
                <svg class="w-6 h-6 sm:w-7 sm:h-7 fill-current" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
              </a>
            )}
            {store.threadsUrl && (
              <a
                href={store.threadsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-gold-600 transition-all duration-300 hover:scale-115 inline-flex items-center justify-center p-1"
                aria-label="Threads"
                title="Threads"
              >
                <svg class="w-6 h-6 sm:w-7 sm:h-7 fill-current" viewBox="0 0 24 24">
                  <path d="M18.263 11.097c-.03-3.486-1.92-5.586-5.111-5.586-2.13 0-3.922.963-4.863 2.499l2.062 1.438c.535-.843 1.272-1.543 2.628-1.543 1.528 0 2.318.85 2.544 2.431a15 15 0 0 0-2.236-.173c-4.125 0-6.068 1.867-6.068 4.336s1.943 3.99 4.804 3.99c3.139 0 5.013-2.115 5.781-4.735.798.361 1.348 1.204 1.348 2.47 0 3.387-3.907 5.232-7.22 5.232-4.885 0-8.077-3.207-8.077-8.424 0-6.392 4.223-10.487 9.9-10.487 3.808 0 5.69 1.671 6.97 3.914l2.108-1.475C21.44 2.078 18.331 0 13.663 0 6.227 0 1.168 5.277 1.168 12.934c0 7 4.953 11.066 10.856 11.066 4.878 0 9.809-2.846 9.809-7.716 0-2.545-1.46-4.231-3.569-5.187m-6.33 4.855c-1.077 0-2.026-.512-2.026-1.453 0-1.483 1.822-1.934 3.606-1.934.678 0 1.34.045 1.927.173-.422 1.927-1.671 3.215-3.508 3.214Z"/>
                </svg>
              </a>
            )}
            {store.xUrl && (
              <a
                href={store.xUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-gold-600 transition-all duration-300 hover:scale-115 inline-flex items-center justify-center p-1"
                aria-label="X (Twitter)"
                title="X (Twitter)"
              >
                <svg class="w-6 h-6 sm:w-7 sm:h-7 fill-current" viewBox="0 0 24 24">
                  <path d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z"/>
                </svg>
              </a>
            )}
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row justify-between items-center text-xs sm:text-sm font-sans tracking-wider text-[#f5ede4]/60">
      <p>© {store.copyrightYear} {store.nameEn}. All Rights Reserved.</p>
      <a href="#" class="mt-4 sm:mt-0 hover:text-gold-600 text-[#f5ede4]/80 transition-colors flex items-center gap-1.5 font-medium">
        <span>{footer.backToTop}</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
      </a>
    </div>
  </div>
</footer>
