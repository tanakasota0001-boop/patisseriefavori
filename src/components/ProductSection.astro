---
import { products, categories } from '../data/products';
import { siteConfig } from '../data/siteConfig';
const { menu } = siteConfig.content;
---

<section id="collection" class="py-24 sm:py-32 bg-cream-100/50 text-noir-900 relative border-t border-stone-200/60">
  <div class="max-w-[1800px] mx-auto px-4 sm:px-6 lg:px-10 scroll-fade-in">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-3.5 mb-16 sm:mb-20">
      <span class="text-[11px] sm:text-xs font-sans tracking-[0.3em] uppercase text-gold-600 font-semibold block">{menu.badge}</span>
      <h2 class="text-3xl sm:text-5xl lg:text-6xl font-serif-title tracking-[0.2em] font-light uppercase text-noir-900">
        {menu.titleEn}
      </h2>
      <div class="w-10 h-[1px] bg-gold-600/80 mx-auto"></div>
      <p class="font-serif-jp text-xs sm:text-sm text-stone-600 tracking-[0.18em] pt-1 leading-relaxed">
        {menu.subtitleJa}
      </p>
    </div>

    <!-- Category Filter Tabs -->
    <div class="flex flex-wrap justify-center items-center gap-2 sm:gap-3 lg:gap-4 mb-12 sm:mb-16 max-w-4xl mx-auto" id="category-filter-tabs">
      {categories.map((cat, idx) => (
        <button
          type="button"
          class={`cat-tab px-3.5 sm:px-5 lg:px-6 py-2 sm:py-2.5 text-[11px] sm:text-xs font-sans tracking-wider sm:tracking-widest uppercase transition-all duration-300 border rounded-sm flex items-center justify-center ${
            idx === 0 ? 'cat-tab-active' : ''
          }`}
          data-category={cat.id}
        >
          <span class="font-medium whitespace-nowrap">{cat.label}</span>
          <span class="cat-sublabel text-[10px] ml-1 whitespace-nowrap opacity-80">({cat.subLabel})</span>
        </button>
      ))}
    </div>

    <!-- Products Grid (Image-centric, 2 cols on mobile, 4 cols on large screens) -->
    <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-2 sm:gap-x-2.5 lg:gap-3 gap-y-4 sm:gap-y-6 lg:gap-y-8" id="products-grid">
      {products.map(product => (
        <div
          class="product-item group cursor-pointer flex flex-col"
          data-category={product.category}
          data-product-id={product.id}
          onclick={`openProductModal('${product.id}')`}
        >
          <!-- Portrait Image Thumbnail -->
          <div class="relative aspect-[3/4] sm:aspect-[4/5] lg:aspect-[3/4] overflow-hidden bg-stone-100 mb-2 sm:mb-2.5">
            <img
              src={product.image}
              alt={product.name}
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-106 transition-transform duration-700 ease-out"
            />
            <!-- Chic Monochrome Hover Overlay (matching Instagram badge style) -->
            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-all duration-300 flex items-center justify-center">
              <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-black/75 backdrop-blur-md border border-white/20 text-white shadow-lg transform translate-y-1 group-hover:translate-y-0 transition-transform duration-300">
                <span class="text-xs font-serif-jp tracking-wider text-white/95 font-medium">{menu.hoverBadge}</span>
                <svg class="w-3.5 h-3.5 text-white/80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </div>
            </div>
          </div>

          <!-- Minimalist Info Below Image (Name & Price Only, Compact & Refined) -->
          <div class="flex justify-between items-baseline gap-2 sm:gap-3 pt-1.5 px-0.5">
            <h3 class="min-w-0 flex-1 text-xs sm:text-sm lg:text-[15px] font-serif-jp text-stone-900 group-hover:text-gold-600 transition-colors font-medium truncate tracking-wide">
              {product.name}
            </h3>
            <span class="text-xs sm:text-sm font-sans font-medium text-stone-700 tracking-wider flex-shrink-0">
              {product.price}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Product Detail Modal -->
<div
  id="product-modal"
  class="fixed inset-0 z-50 overflow-y-auto hidden"
  style="display: none;"
  aria-modal="true"
  role="dialog"
>
  <!-- Backdrop -->
  <div
    id="product-modal-backdrop"
    class="fixed inset-0 bg-noir-950/85 backdrop-blur-sm transition-opacity"
    onclick="closeProductModal()"
  ></div>

  <!-- Modal Container -->
  <div class="min-h-full flex items-center justify-center p-4 sm:p-6 text-center">
    <div
      id="product-modal-card"
      class="relative bg-cream-50 max-w-3xl w-full text-left rounded-sm shadow-2xl overflow-hidden flex flex-col md:flex-row my-8 z-10"
      onclick="event.stopPropagation()"
    >
      <!-- Modal Image -->
      <div class="md:w-1/2 aspect-square md:aspect-auto relative bg-noir-900 overflow-hidden">
        <img
          id="modal-image"
          src=""
          alt=""
          class="w-full h-full object-cover min-h-[300px] border-0 outline-none"
        />
      </div>

      <!-- Modal Info -->
      <div class="p-6 sm:p-8 md:w-1/2 flex flex-col justify-between space-y-6">
        <div class="space-y-4">
          <div>
            <span id="modal-category" class="text-[10.5px] font-sans tracking-[0.25em] uppercase text-gold-600 font-semibold block mb-1.5"></span>
            <h3 id="modal-title" class="text-xl sm:text-2xl font-serif-jp text-noir-900 font-normal leading-snug tracking-wide"></h3>
          </div>

          <div class="text-xl sm:text-2xl font-sans font-medium text-stone-900 border-b border-stone-200/80 pb-3.5">
            <span id="modal-price"></span>
            <span class="text-xs text-stone-400 font-normal ml-1 tracking-normal">{menu.taxLabel}</span>
          </div>

          <div>
            <p id="modal-desc" class="text-stone-700 font-serif-jp text-xs sm:text-sm leading-[2] tracking-wide"></p>
          </div>
        </div>

        <div class="pt-4 border-t border-stone-200">
          <button
            type="button"
            onclick="closeProductModal()"
            class="w-full py-2.5 bg-gold-600 hover:bg-gold-700 text-white text-xs font-sans tracking-widest uppercase transition-colors rounded-sm text-center font-medium shadow-md"
          >
            {menu.closeButtonText}
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ products }}>
  window.__PRODUCTS_DATA__ = products;
</script>

<script is:inline>
  // Category filtering
  const tabs = document.querySelectorAll('.cat-tab');
  const items = document.querySelectorAll('.product-item');

  function setTabActive(activeTab) {
    tabs.forEach(tab => tab.classList.remove('cat-tab-active'));
    activeTab.classList.add('cat-tab-active');
  }

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      setTabActive(tab);

      const selectedCategory = tab.getAttribute('data-category');

      items.forEach(item => {
        const itemCat = item.getAttribute('data-category');
        if (selectedCategory === 'all' || itemCat === selectedCategory) {
          item.style.display = 'flex';
        } else {
          item.style.display = 'none';
        }
      });
    });
  });

  // Modal logic
  const modal = document.getElementById('product-modal');
  const modalImage = document.getElementById('modal-image');
  const modalCategory = document.getElementById('modal-category');
  const modalTitle = document.getElementById('modal-title');
  const modalPrice = document.getElementById('modal-price');
  const modalDesc = document.getElementById('modal-desc');

  window.openProductModal = function(productId) {
    const p = window.__PRODUCTS_DATA__?.find(item => item.id === productId);
    if (!p || !modal) return;

    modalImage.src = p.image;
    modalImage.alt = p.name;
    modalCategory.textContent = p.categoryLabel;
    modalTitle.textContent = p.name;
    modalPrice.textContent = p.price;
    modalDesc.textContent = p.description;

    modal.classList.remove('hidden');
    modal.style.display = 'block';
    document.body.style.overflow = 'hidden';
  };

  window.closeProductModal = function() {
    if (!modal) return;
    modal.classList.add('hidden');
    modal.style.display = 'none';
    document.body.style.overflow = '';
  };
</script>

<style>
  /* Inactive tab state */
  .cat-tab {
    background-color: transparent;
    color: #57534e; /* text-stone-600 */
    border-color: #d6d3d1; /* border-stone-300 */
  }

  @media (hover: hover) and (pointer: fine) {
    .cat-tab:not(.cat-tab-active):hover {
      border-color: #b4824d; /* border-brand-600 */
      color: #b4824d; /* text-brand-600 */
    }
  }

  /* Active tab state - guaranteed identical noir background and cream text across all selections */
  .cat-tab.cat-tab-active,
  .cat-tab.cat-tab-active:hover,
  .cat-tab.cat-tab-active:focus,
  .cat-tab.cat-tab-active:active {
    background-color: #181716 !important; /* bg-noir-900 */
    color: #fdfcf9 !important; /* text-cream-50 */
    border-color: #181716 !important; /* border-noir-900 */
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  }

  .cat-tab.cat-tab-active span,
  .cat-tab.cat-tab-active:hover span,
  .cat-tab.cat-tab-active:focus span {
    color: #fdfcf9 !important;
  }
</style>
