---
import { siteConfig } from '../data/siteConfig';
const { store } = siteConfig;
const { contact: contactText } = siteConfig.content;
---

<div
  id="contact-modal"
  class="fixed inset-0 z-50 overflow-y-auto hidden"
  style="display: none;"
  aria-modal="true"
  role="dialog"
>
  <!-- Backdrop -->
  <div
    id="contact-modal-backdrop"
    class="fixed inset-0 bg-noir-950/85 backdrop-blur-sm transition-opacity"
    onclick="closeContactModal()"
  ></div>

  <!-- Screen Fixed Close Button -->
  <button
    type="button"
    onclick="closeContactModal()"
    class="fixed top-4 right-4 sm:top-6 sm:right-6 z-50 flex items-center gap-2 px-4 py-2 bg-cream-50/95 hover:bg-noir-900 hover:text-cream-50 text-stone-900 text-xs font-sans tracking-widest uppercase rounded-full shadow-2xl transition-all duration-200 border border-stone-300 group"
    aria-label="閉じる"
  >
    <svg class="w-4 h-4 group-hover:rotate-90 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    <span class="font-medium">閉じる</span>
  </button>

  <!-- Modal Container -->
  <div class="min-h-full flex items-center justify-center p-4 sm:p-6 text-center">
    <div
      id="contact-modal-card"
      class="relative bg-cream-50 max-w-xl w-full text-left rounded-sm shadow-2xl border border-stone-300 p-6 sm:p-8 my-8 z-10"
      onclick="event.stopPropagation()"
    >
      <!-- Modal Header -->
      <div class="text-center space-y-2 mb-6">
        <span class="text-[10px] font-sans tracking-mega-wide uppercase text-gold-600 block">{contactText.badge}</span>
        <h3 class="text-2xl sm:text-3xl font-serif-title tracking-wider uppercase text-noir-900 font-light">{contactText.titleEn}</h3>
        <div class="w-10 h-[1px] bg-gold-600 mx-auto"></div>
        <p class="text-xs sm:text-sm font-serif-jp text-stone-800 font-medium pt-1">
          {contactText.subtitleJa}
        </p>
        <p class="text-xs text-stone-600 font-serif-jp leading-relaxed max-w-md mx-auto pt-1">
          {contactText.desc}
        </p>
      </div>

      <!-- Main Phone CTA Box -->
      <div class="mb-6 p-5 sm:p-6 bg-cream-200/90 border border-gold-600/30 rounded-sm text-center shadow-sm">
        <p class="text-xs text-stone-700 font-serif-jp font-medium mb-2.5">{contactText.phoneNoticeTitle}</p>
        <a
          href={`tel:${store.tel.replace(/-/g, '')}`}
          class="inline-flex items-center justify-center gap-3 px-6 py-3.5 bg-noir-900 hover:bg-gold-600 text-cream-50 text-xl sm:text-2xl font-sans font-bold tracking-wider rounded-sm transition-all duration-300 shadow-md group w-full sm:w-auto"
        >
          <svg class="w-5 h-5 text-gold-600 group-hover:text-cream-50 transition-colors animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <span>{store.tel}</span>
        </a>
        <p class="text-xs text-stone-600 font-serif-jp mt-3">{contactText.hoursText}</p>
      </div>

      <!-- Checklist Section -->
      <div class="space-y-4 mb-6">
        <div class="bg-white/80 p-4 rounded-sm border border-stone-200">
          <h4 class="text-xs font-serif-jp font-bold text-noir-900 mb-3 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-gold-600"></span>
            {contactText.checklistTitle}
          </h4>
          <ul class="space-y-2.5 text-xs font-serif-jp text-stone-700">
            {contactText.checklistItems.map((item, idx) => (
              <li class="flex items-start gap-2.5">
                <span class="font-sans font-bold text-gold-600 flex-shrink-0 text-xs">{idx + 1}.</span>
                <div>
                  <span class="font-medium text-stone-900">{item.label}</span>
                  <span class="text-stone-500 block text-[11px] mt-0.5">{item.detail}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <!-- Notes / Notice List -->
        <div class="p-4 bg-stone-100/70 rounded-sm border border-stone-200/80 text-[11px] font-serif-jp text-stone-600 space-y-1.5 leading-relaxed">
          <p class="font-bold text-stone-800 text-xs mb-1 flex items-center gap-1">
            <svg class="w-3.5 h-3.5 text-stone-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            {contactText.noticeTitle}
          </p>
          {contactText.noticeList.map(notice => (
            <p>• {notice}</p>
          ))}
        </div>
      </div>

      <!-- Close Button -->
      <div class="pt-2">
        <button
          type="button"
          onclick="closeContactModal()"
          class="w-full py-2.5 bg-transparent border border-stone-300 text-stone-700 hover:text-stone-900 hover:border-stone-500 text-xs font-sans tracking-widest uppercase transition-colors rounded-sm text-center font-medium"
        >
          {contactText.closeBtnText}
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  const contactModal = document.getElementById('contact-modal');

  window.openContactModal = function() {
    if (!contactModal) return;
    contactModal.classList.remove('hidden');
    contactModal.style.display = 'block';
    document.body.style.overflow = 'hidden';
  };

  window.closeContactModal = function() {
    if (!contactModal) return;
    contactModal.classList.add('hidden');
    contactModal.style.display = 'none';
    document.body.style.overflow = '';
  };
</script>
