---
import { siteConfig } from '../data/siteConfig';
const { concept: conceptImg } = siteConfig.images;
const { concept: conceptText } = siteConfig.content;
---

<section id="concept" class="py-24 sm:py-32 bg-cream-50 text-noir-900 relative overflow-hidden">
  <div class="max-w-[1560px] mx-auto px-6 sm:px-8 lg:px-12 scroll-fade-in">
    <!-- Section Header (with GSAP trigger) -->
    <div class="anim-section-header text-center max-w-3xl mx-auto space-y-3.5 mb-16 sm:mb-24">
      <span class="anim-subtitle text-[11px] sm:text-xs font-sans tracking-[0.3em] uppercase text-gold-600 font-semibold block">{conceptText.badge}</span>
      <h2 class="anim-title-en text-3xl sm:text-5xl lg:text-6xl font-serif-title tracking-[0.2em] font-light uppercase text-noir-900">
        {conceptText.titleEn}
      </h2>
      <div class="anim-gold-line w-10 h-[1px] bg-gold-600/80 mx-auto"></div>
      <p class="anim-title-ja font-serif-jp text-xs sm:text-sm text-stone-600 tracking-[0.18em] pt-1 leading-relaxed">{conceptText.subtitleJa}</p>
    </div>

    <!-- Editorial Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center">
      <!-- Image Left with Parallax -->
      <div class="lg:col-span-6 relative">
        <div class="relative z-10 overflow-hidden shadow-2xl rounded-sm">
          <img
            src={conceptImg.main}
            alt="Pastry Chef crafting cakes"
            class="concept-img-main w-full h-[480px] sm:h-[600px] lg:h-[660px] object-cover card-img-parallax will-change-transform"
          />
        </div>
        <!-- Floating secondary small image with offset parallax -->
        <div class="concept-img-sub hidden sm:block absolute -bottom-8 -right-8 w-60 h-60 z-20 overflow-hidden shadow-xl border-2 border-white/80 rounded-sm will-change-transform">
          <img
            src={conceptImg.sub}
            alt="Handcrafted pastry details"
            class="w-full h-full object-cover card-img-parallax"
          />
        </div>
      </div>

      <!-- Text Right -->
      <div class="lg:col-span-6 space-y-6 lg:pl-6">
        <div class="space-y-6">
          <h3 class="concept-text-anim text-2xl sm:text-3xl lg:text-[34px] xl:text-[36px] font-serif-jp font-light leading-[1.65] tracking-[0.06em] text-noir-900 pb-1">
            {(conceptText.lead || "すべてのお客さまの\n心のカギになるスイーツを").split('\n').map((line: string) => (
              <span class="block">{line}</span>
            ))}
          </h3>
          {conceptText.paragraphs.map(p => (
            <p class="concept-text-anim text-stone-700 font-serif-jp text-sm sm:text-[15px] leading-[2.1] tracking-[0.05em] whitespace-pre-line">
              {p}
            </p>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
