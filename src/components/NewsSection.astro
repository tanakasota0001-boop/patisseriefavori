---
import { newsItems } from '../data/news';
import { siteConfig } from '../data/siteConfig';
const { gallery } = siteConfig.images;
const { news: newsText } = siteConfig.content;
const { store } = siteConfig;

// Seamless loop needs 2 identical sets of images
const loopedGallery = [...gallery, ...gallery];
---

<section id="news" class="pt-24 sm:pt-32 pb-0 bg-cream-100/50 text-noir-900 border-t border-stone-200/60 overflow-hidden">
  <!-- News List Section (Standard Width Container) -->
  <div class="max-w-[1560px] mx-auto px-6 sm:px-8 lg:px-12 scroll-fade-in mb-20 sm:mb-28">
    <!-- Header -->
    <div class="anim-section-header text-center max-w-3xl mx-auto space-y-3.5 mb-16 sm:mb-20">
      <span class="anim-subtitle text-[11px] sm:text-xs font-sans tracking-[0.3em] uppercase text-gold-600 font-semibold block">{newsText.badge}</span>
      <h2 class="anim-title-en text-3xl sm:text-5xl lg:text-6xl font-serif-title tracking-[0.2em] font-light uppercase text-noir-900">
        {newsText.titleEn}
      </h2>
      <div class="anim-gold-line w-10 h-[1px] bg-gold-600/80 mx-auto"></div>
    </div>

    <!-- News List -->
    <div class="max-w-5xl mx-auto divide-y divide-stone-200 border-y border-stone-200">
      {newsItems.map(item => (
        <article class="news-card-anim py-7 sm:py-8 group hover:bg-cream-100/80 transition-colors px-4 sm:px-6">
          <div class="flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-8">
            <div class="min-w-[120px] sm:min-w-[140px] flex-shrink-0">
              <time datetime={item.date} class="text-xs sm:text-sm font-sans font-medium text-stone-500 tracking-wider">
                {item.date}
              </time>
            </div>
            
            <div class="flex-1 space-y-1.5">
              <h3 class="text-base sm:text-lg lg:text-[18px] font-serif-jp font-medium text-stone-900 group-hover:text-gold-600 transition-colors leading-snug tracking-wide">
                {item.title}
              </h3>
              <p class="text-xs sm:text-sm text-stone-600 font-serif-jp leading-relaxed tracking-wide">
                {item.excerpt}
              </p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- Instagram Gallery Showcase (Distinct Visual Block) -->
  <div class="w-full pt-16 sm:pt-20 pb-0 bg-cream-50/80 border-t border-stone-200/60 overflow-hidden">
    <!-- Centered Editorial Instagram Header -->
    <div class="max-w-xl mx-auto px-6 text-center mb-10 sm:mb-12 space-y-3">
      <div class="inline-flex items-center justify-center">
        <svg class="w-5 h-5 text-gold-600 fill-current" viewBox="0 0 24 24">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
      </div>

      <h3 class="text-2xl sm:text-3xl font-serif-title tracking-[0.2em] font-light text-stone-900 uppercase">
        Instagram
      </h3>

      <div class="pt-2">
        <a
          href={store.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-2.5 rounded-sm border border-stone-300 hover:border-gold-600 bg-white/95 hover:bg-white text-xs font-sans tracking-[0.2em] uppercase text-stone-700 hover:text-gold-600 shadow-sm transition-all duration-300 group font-medium"
        >
          <span>{newsText.instagramCta}</span>
          <svg class="w-3.5 h-3.5 text-stone-400 group-hover:text-gold-600 transform group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
      </div>
    </div>

    <!-- Continuous Infinite Marquee Track (Full-width, Right to Left, Seamless without gaps) -->
    <div class="relative w-full overflow-hidden marquee-container select-none">
      <div class="flex marquee-track">
        {loopedGallery.map((photo) => (
          <a
            href={store.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative flex-shrink-0 w-60 h-60 sm:w-72 sm:h-72 md:w-80 md:h-80 overflow-hidden block"
          >
            <img
              src={photo.url}
              alt={photo.caption}
              loading="lazy"
              class="w-full h-full object-cover block group-hover:scale-108 transition-transform duration-700 ease-out"
            />
            <!-- Chic Monochrome Overlay with Instagram Icon & Text -->
            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-all duration-300 flex items-center justify-center">
              <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-black/75 backdrop-blur-md border border-white/20 text-white shadow-lg transform translate-y-1 group-hover:translate-y-0 transition-transform duration-300">
                <svg class="w-4 h-4 fill-current text-white/90" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                <span class="text-xs font-serif-jp tracking-wider text-white/95 font-medium">{newsText.instagramHoverBadge}</span>
                <svg class="w-3.5 h-3.5 text-white/80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Continuous infinite right-to-left marquee animation */
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 38s linear infinite;
  }

  .marquee-container:hover .marquee-track {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
